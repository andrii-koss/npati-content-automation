{
  "name": "npati/npati-content-automation",
  "description": "WordPress plugin for content planning, AI-assisted writing, SEO workflows, scheduling, and NPATI Hub integration",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "require": { "php": ">=7.4" },
  "require-dev": {
    "phpunit/phpunit": "^9.6",
    "squizlabs/php_codesniffer": "^3.13",
    "wp-coding-standards/wpcs": "^3.2"
  },
  "scripts": {
    "lint": "phpcs --standard=phpcs.xml.dist",
    "test": "phpunit"
  }
}
